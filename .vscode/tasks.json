{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "/opt/homebrew/bin/fnm",
			"args": ["exec", "--using=22.22.0", "corepack", "pnpm", "run", "compile"],
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch",
			"dependsOn": ["watch:tsc", "watch:esbuild"],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "watch:tsc",
			"type": "shell",
			"command": "/opt/homebrew/bin/fnm",
			"args": ["exec", "--using=22.22.0", "corepack", "pnpm", "run", "watch:tsc"],
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"presentation": {
				"reveal": "never",
				"group": "watch"
			}
		},
		{
			"label": "watch:esbuild",
			"type": "shell",
			"command": "/opt/homebrew/bin/fnm",
			"args": ["exec", "--using=22.22.0", "corepack", "pnpm", "run", "watch:esbuild"],
			"isBackground": true,
			"problemMatcher": "$esbuild-watch",
			"presentation": {
				"reveal": "never",
				"group": "watch"
			}
		}
	]
}
